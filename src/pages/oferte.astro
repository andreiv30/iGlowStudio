---
import { seoPagina } from '../lib/seo';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import CtaCard from '../components/CtaCard.astro';
import setari from '../data/setari.json';
import { rezervaHref, rezervaExtern } from '../lib/nav';

const oferte = (await getCollection('oferte')).filter((o) => o.data.activ).sort((a, b) => a.data.ordine - b.data.ordine);
const ext = rezervaExtern ? { rel: 'noopener', target: '_blank' } : {};
---
<Base {...seoPagina('oferte')}>
  <PageHead eticheta="Oferte" titlu="Oferte speciale *pentru tine*" text="Pachete și promoții limitate. Actualizăm periodic această pagină, așa că rezervă din timp: locurile depind de disponibilitatea echipei." />

  <section class="offers container" aria-label="Oferte active">
    {oferte.length === 0 ? (
      <p class="lead empty">Momentan nu avem oferte active. Urmărește-ne pe <a href={setari.instagram} rel="noopener" target="_blank">Instagram</a> ca să le afli primele.</p>
    ) : (
      <div class="offers__grid">
        {oferte.map((o, i) => (
          <article class="offer card" data-reveal style={`--i: ${i}`}>
            {o.data.imagine && <img class="offer__img" src={o.data.imagine} alt="" loading="lazy" />}
            <div class="offer__body">
              <p class="offer__meta">
                {o.data.eticheta && <span class="offer__tag">{o.data.eticheta}</span>}
                <span>{o.data.valabil_pana ? `Valabilă până la ${o.data.valabil_pana}` : 'Ofertă permanentă'}</span>
              </p>
              <h2 class="offer__title">{o.data.titlu}</h2>
              <p class="offer__text">{o.data.detaliu}</p>
              <div class="offer__foot">
                <p class="offer__price"><span>Preț ofertă</span>{o.data.pret} {o.data.pret_vechi && <s>{o.data.pret_vechi}</s>}</p>
                <a class="btn btn--small" href={rezervaHref} {...ext}>Rezervă <Icon name="arrow" size={14} /></a>
              </div>
            </div>
          </article>
        ))}
      </div>
    )}
    <p class="offers__note" data-reveal><Icon name="gift" size={22} /> Ofertele nu se cumulează cu alte reduceri, cu excepția cazului în care este menționat explicit. Detalii în <a href="/termeni-si-conditii">Termeni și condiții</a>.</p>
  </section>

  <CtaCard />
</Base>

<style>
  .offers { padding-top: clamp(3.5rem, 6vw, 5rem); display: flex; flex-direction: column; gap: 2.5rem; }
  .offers__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; }
  .offer { overflow: hidden; display: flex; flex-direction: column; }
  .offer__img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
  .offer__body { padding: 2rem; display: flex; flex-direction: column; gap: 1rem; flex: 1; }
  .offer__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--muted); }
  .offer__tag { padding: 0.35rem 0.7rem; border: 1px solid var(--caramel); border-radius: 6px; color: var(--taupe); }
  .offer__title { font-size: 2rem; font-style: italic; line-height: 1.15; }
  .offer__text { color: var(--muted); }
  .offer__foot { margin-top: auto; padding-top: 1.25rem; border-top: 1px solid var(--line); display: flex; justify-content: space-between; align-items: flex-end; gap: 1rem; flex-wrap: wrap; }
  .offer__price { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.6rem; font-family: var(--font-display); font-size: 2rem; line-height: 1; }
  .offer__price span { flex-basis: 100%; font-family: var(--font-text); font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.22em; text-transform: uppercase; color: var(--muted); }
  .offer__price s { font-size: 1.1rem; color: var(--muted); }
  /* nota de jos, ca pastila cu cadou de pe flyer */
  .offers__note { display: flex; align-items: center; gap: 1rem; max-width: 52rem; margin-inline: auto; padding: 1rem 1.75rem; border: 1px solid var(--caramel); border-radius: 999px; font-size: 0.875rem; color: var(--muted); }
  .offers__note :global(svg) { color: var(--caramel); flex: none; }
  .empty { text-align: center; margin-inline: auto; }
  @media (max-width: 48rem) {
    .offers__grid { grid-template-columns: 1fr; }
    .offers__note { border-radius: var(--radius); }
  }
</style>
