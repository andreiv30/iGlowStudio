---
import { seoPagina } from '../lib/seo';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import setari from '../data/setari.json';
const f = setari.firma;
const rows = [
  ['Denumire', f.denumire], ['Cod unic de înregistrare (CUI)', f.cui], ['Nr. Registrul Comerțului', f.reg_com],
  ['EUID', f.euid], ['Data înființării', f.data_infiintare],
  ['Sediu social', f.sediu], ['Capital social', f.capital], ['Cont bancar', f.banca],
  ['Punct de lucru', `${setari.adresa}, ${setari.oras}`], ['Telefon', setari.telefon], ['Email', setari.email],
].filter(([, v]) => v && !/^\[.*\]$/.test(String(v).trim()));
---
<Base {...seoPagina('date-identificare')}>
  <PageHead eticheta="Informații legale" titlu="Date identificare *societate*" />
  <section class="container section section--plain">
    <dl class="ids card" data-reveal>{rows.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
  </section>
</Base>
<style>
  .ids { max-width: 46rem; margin: 0 auto; overflow: hidden; }
  .ids div { display: grid; grid-template-columns: 16rem 1fr; gap: 1rem; padding: 1.1rem 1.75rem; }
  .ids div + div { border-top: 1px solid var(--line); }
  .ids dt { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); padding-top: 0.15rem; }
  .ids dd { margin: 0; }
  @media (max-width: 40rem) { .ids div { grid-template-columns: 1fr; gap: 0.25rem; } }
</style>
