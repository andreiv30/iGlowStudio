---
import { seoPagina } from '../lib/seo';
// „Rezervă” duce la platforma de programări. Când linkul e completat în /admin,
// butoanele din site merg direct acolo, iar pagina aceasta redirecționează automat.
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import setari from '../data/setari.json';
const online = setari.link_rezervare?.trim();
const tel = setari.telefon.replace(/\s/g, '');
---
<Base {...seoPagina('rezerva')}>
  {online && <meta http-equiv="refresh" content={`0;url=${online}`} slot="head" />}
  <PageHead eticheta="Rezervă" titlu="Programează-te *online*" text="Alege serviciul, specialistul, ziua și ora. Îți confirmăm programarea cât mai repede.">
    <div class="book__actions" data-load style="--i: 3">
      {online
        ? <a class="btn" href={online} rel="noopener">Alege ziua și ora <Icon name="arrow-up-right" size={16} /></a>
        : <a class="btn" href={`tel:${tel}`}>Sună pentru programare <Icon name="phone" size={16} /></a>}
      <a class="btn btn--outline" href={`https://wa.me/${setari.whatsapp}?text=${encodeURIComponent('Bună! Aș dori o programare la iGlow.')}`} rel="noopener" target="_blank"><Icon name="whatsapp" size={16} /> WhatsApp</a>
    </div>
  </PageHead>

  <section class="ways container section" aria-label="Alte moduri de programare">
    <a class="way card" href={`tel:${tel}`} data-reveal><span class="ring"><Icon name="phone" size={24} /></span><span class="way__t">Telefon</span><span class="muted">{setari.telefon}</span></a>
    <a class="way card" href={`https://wa.me/${setari.whatsapp}`} rel="noopener" target="_blank" data-reveal style="--i: 1"><span class="ring"><Icon name="whatsapp" size={24} /></span><span class="way__t">WhatsApp</span><span class="muted">Scrie-ne un mesaj</span></a>
    <a class="way card" href={`mailto:${setari.email}`} data-reveal style="--i: 2"><span class="ring"><Icon name="mail" size={24} /></span><span class="way__t">Email</span><span class="muted">{setari.email}</span></a>
  </section>
</Base>
<style>
  .book__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; margin-top: 0.5rem; }
  .ways { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; }
  .way { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 0.6rem; padding: 2.5rem 1.5rem; text-decoration: none; transition: transform 300ms var(--ease-out); }
  .way .ring { margin-bottom: 0.75rem; }
  .way__t { font-size: 0.875rem; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; }
  @media (hover: hover) and (pointer: fine) { .way:hover { transform: translateY(-4px); } }
  @media (max-width: 48rem) { .ways { grid-template-columns: 1fr; } }
</style>
