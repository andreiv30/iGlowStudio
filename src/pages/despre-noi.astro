---
import { seoPagina, altImg } from '../lib/seo';
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import despre from '../data/despre.json';
import setari from '../data/setari.json';
import { accent, rezervaHref, rezervaExtern } from '../lib/nav';
const ext = rezervaExtern ? { rel: 'noopener', target: '_blank' } : {};
const hartaSrc = `https://maps.google.com/maps?q=${encodeURIComponent(setari.harta_embed || `${setari.adresa}, ${setari.oras}`)}&z=17&hl=ro&output=embed`;
---
<Base {...seoPagina('despre-noi')} image={despre.poveste_imagine || undefined}>
  <!-- citatul fondatoarei, centrat -->
  <header class="page-head">
    <div class="container head head--center">
      <p class="eyebrow eyebrow--center" data-load>Despre noi</p>
      <h1 class="h1 quote" data-load style="--i: 1" set:html={`„${accent(despre.citat)}”`} />
      <p class="quote__by" data-load style="--i: 2">— {despre.citat_autor}</p>
    </div>
  </header>

  <!-- povestea + poza -->
  <section class="story section" aria-labelledby="story-title">
    <div class="container story__inner">
      <div class="head">
        <p class="eyebrow" data-reveal id="story-title">{despre.poveste_titlu}</p>
        <div class="story__text" data-reveal style="--i: 1">
          {despre.poveste.map((p) => <p>{p}</p>)}
        </div>
        <div class="story__actions" data-reveal style="--i: 2">
          <a class="btn btn--outline" href="/echipa">Vezi echipa</a>
          <a class="btn" href="/servicii">Vezi servicii</a>
        </div>
      </div>
      <div data-reveal style="--i: 1"><Photo src={despre.poveste_imagine} alt={altImg('Interiorul salonului')} ratio="4 / 5" /></div>
    </div>
  </section>

  <!-- contact și locație, ca pe Caracter -->
  <section class="visit section section--surface" aria-labelledby="visit-title">
    <div class="container">
      <div class="visit__card card">
        <div class="head head--center">
          <p class="eyebrow eyebrow--center" data-reveal>Contact & locație</p>
          <h2 id="visit-title" class="h2" data-reveal style="--i: 1" set:html={accent(despre.contact_titlu)} />
          <p class="lead" data-reveal style="--i: 2">{despre.contact_text}</p>
        </div>
        <div class="visit__grid">
          <div class="place" data-reveal>
            <div class="place__name"><span class="ring ring--small"><Icon name="pin" size={18} /></span><div><h3>{setari.nume}</h3><p>{setari.oras}</p></div></div>
            <dl class="place__info">
              <div><dt>Adresă</dt><dd>{setari.adresa}<br />{setari.oras}<br /><span class="muted">{setari.adresa_detalii}</span></dd></div>
              <div><dt>Telefon</dt><dd><a href={`tel:${setari.telefon.replace(/\s/g, '')}`}>{setari.telefon}</a></dd></div>
              <div><dt>Program</dt><dd><ul class="hours">{setari.program.map((p) => <li><span>{p.zile}</span><span>{p.ore}</span></li>)}</ul></dd></div>
            </dl>
            <a class="btn btn--block" href={rezervaHref} {...ext}>Rezervă online</a>
          </div>
          <div class="map" data-reveal style="--i: 1" data-map>
            <!-- harta Google se încarcă după acordul pentru cookie-uri de preferințe sau la apăsarea butonului -->
            <iframe class="map__frame" title={`Harta: ${setari.nume}, ${setari.adresa}, ${setari.oras}`} data-consent="preferinte" data-consent-src={hartaSrc} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
            <div class="map__cover">
              <span class="ring"><Icon name="pin" size={26} /></span>
              <p class="map__addr">{setari.adresa}<br />{setari.oras}</p>
              <button type="button" class="btn btn--outline btn--small" data-map-load>Afișează harta</button>
              <p class="map__note">Harta este furnizată de Google și poate folosi cookie-uri.</p>
            </div>
            <a class="map__link" href={setari.link_harta} rel="noopener" target="_blank">Deschide în Google Maps <Icon name="arrow-up-right" size={14} /></a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  // harta: se încarcă la apăsarea butonului sau singură, dacă vizitatorul a acceptat cookie-urile de preferințe
  document.querySelectorAll<HTMLElement>('[data-map]').forEach((map) => {
    const frame = map.querySelector<HTMLIFrameElement>('iframe');
    if (!frame) return;
    const show = () => { if (frame.getAttribute('src')) map.classList.add('is-loaded'); };
    frame.addEventListener('load', show);
    map.querySelector('[data-map-load]')?.addEventListener('click', () => {
      if (!frame.getAttribute('src')) frame.src = frame.dataset.consentSrc || '';
      map.classList.add('is-loaded');
    });
    show();
  });
</script>

<style>
  .quote { max-width: 18ch; }
  .quote__by { font-size: 0.8125rem; font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase; color: var(--muted); }
  .story__inner { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr); gap: clamp(2rem, 6vw, 6rem); align-items: center; }
  .story__text { display: flex; flex-direction: column; gap: 1rem; font-size: 1.0625rem; max-width: 40rem; }
  .story__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 0.5rem; }
  .visit__card { padding: clamp(2rem, 5vw, 4rem); display: flex; flex-direction: column; gap: 3rem; }
  .visit__grid { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 1.5rem; }
  .place { background: var(--surface); border-radius: var(--radius); padding: 1.75rem; display: flex; flex-direction: column; gap: 1.5rem; }
  .place__name { display: flex; gap: 1rem; align-items: center; padding-bottom: 1.25rem; border-bottom: 1px solid var(--line); }
  .place__name h3 { font-size: 1.4rem; }
  .place__name p { font-size: 0.75rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--muted); }
  .place__info { display: flex; flex-direction: column; gap: 1.25rem; margin: 0; font-size: 0.9375rem; }
  .place__info dt { font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.22em; text-transform: uppercase; color: var(--muted); margin-bottom: 0.35rem; }
  .place__info dd { margin: 0; }
  .place__info a { color: var(--taupe); }
  .hours { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 0.3rem; }
  .hours li { display: flex; justify-content: space-between; gap: 1rem; font-variant-numeric: tabular-nums; }
  .map { position: relative; min-height: 26rem; border-radius: var(--radius); overflow: hidden; background: #ede6df; }
  .map__frame { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; opacity: 0; transition: opacity 500ms ease; }
  .map.is-loaded .map__frame { opacity: 1; }
  .map__cover { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1rem; padding: 2rem 1.5rem 4.5rem; text-align: center; color: var(--taupe); background: radial-gradient(60% 60% at 50% 40%, rgb(255 255 255 / 0.55), transparent), #ede6df; transition: opacity 400ms ease, visibility 400ms; }
  .map.is-loaded .map__cover { opacity: 0; visibility: hidden; }
  .map__addr { font-family: var(--font-display); font-size: 1.25rem; line-height: 1.35; color: var(--ink); }
  .map__note { font-size: 0.75rem; color: var(--muted); max-width: 22rem; }
  .map__link { position: absolute; left: 1rem; bottom: 1rem; z-index: 1; display: inline-flex; align-items: center; gap: 0.45rem; min-height: 44px; padding: 0 1.1rem; border-radius: 999px; background: var(--alb); box-shadow: var(--shadow); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; text-decoration: none; color: var(--ink); }
  @media (hover: hover) and (pointer: fine) { .map__link:hover { color: var(--caramel-btn); } }
  @media (max-width: 56rem) { .story__inner, .visit__grid { grid-template-columns: 1fr; } .map { min-height: 22rem; } }
</style>
