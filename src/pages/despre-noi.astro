---
import Base from '../layouts/Base.astro';
import Media from '../components/Media.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import acasa from '../data/acasa.json';
import setari from '../data/setari.json';
---
<Base title="Despre noi" description="iGlow Studio, salonul Andreei Pamfiloiu: cum lucrăm și unde ne găsești.">
  <header class="page-head wrap">
    <h1 class="display" data-load>{acasa.despre_titlu}</h1>
    <p class="lead" data-load style="--i: 1">{acasa.despre_text}</p>
  </header>

  <section class="story wrap" aria-labelledby="story-title">
    <Media tone="taupe" seed="despre-1" variant="closeup" ratio="16 / 10" class="story__wide" />
    <div class="story__copy">
      <h2 id="story-title" class="head" data-reveal>De unde vine numele</h2>
      <div class="prose" data-reveal style="--i: 1">
        <p>„Glow” este strălucirea pe care o are părul sănătos în lumina zilei: nu luciul unui produs, ci firul care reflectă lumina pentru că e hrănit, tuns la timp și colorat cu grijă.</p>
        <p>Paleta salonului vine din aceeași idee. Tonurile site-ului, de la Espresso la Auriu deschis, sunt nuanțele de păr cu care lucrăm în fiecare zi.</p>
        <p>[Povestea Andreei: cum a început, ce a învățat, de ce a deschis iGlow. De completat din /admin.]</p>
      </div>
    </div>
  </section>

  <section class="how field-surface" aria-labelledby="how-title">
    <div class="how__inner wrap">
      <h2 id="how-title" class="head" data-reveal>Cum lucrăm</h2>
      <ol class="how__list">
        {acasa.vizita.map((p, i) => (
          <li data-reveal style={`--i: ${i}`}><h3 class="title">{p.titlu}</h3><p>{p.text}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="place wrap" aria-labelledby="place-title">
    <div class="place__copy">
      <h2 id="place-title" class="head" data-reveal>Unde ne găsești</h2>
      <p class="lead" data-reveal style="--i: 1">{setari.adresa}, {setari.oras}</p>
      <p class="muted" data-reveal style="--i: 2">{setari.adresa_detalii}</p>
      <dl class="place__hours nums" data-reveal style="--i: 3">
        {setari.program.map((p) => <div><dt>{p.zile}</dt><dd>{p.ore}</dd></div>)}
      </dl>
      <div class="place__actions" data-reveal style="--i: 4">
        <a class="button" href={setari.link_harta} rel="noopener" target="_blank">Deschide în hartă <Icon name="arrow-up-right" /></a>
        <a class="arrow-link" href="/rezerva">Rezervă o programare <Icon name="arrow" /></a>
      </div>
    </div>
    <Media tone="caramel" seed="despre-2" ratio="3 / 4" class="place__pic" />
  </section>

  <CtaBand />
</Base>

<style>
  .story { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); row-gap: 3rem; padding-bottom: calc(var(--section) / 2); }
  .story :global(.story__wide) { grid-column: 1 / -1; }
  .story__copy { grid-column: 5 / 12; display: flex; flex-direction: column; gap: 2rem; }
  .story__copy .prose { font-size: 1.1875rem; }
  .how__inner { padding-block: calc(var(--section) / 2); display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); row-gap: 3rem; }
  .how h2 { grid-column: 1 / 5; }
  .how__list { grid-column: 5 / 13; list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gutter); }
  .how__list li { display: flex; flex-direction: column; gap: 0.75rem; }
  .place { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); row-gap: 3rem; padding-block: var(--section); align-items: center; }
  .place__copy { grid-column: 1 / 7; display: flex; flex-direction: column; gap: 1.25rem; }
  .place :global(.place__pic) { grid-column: 8 / 13; }
  .place__hours { margin: 1rem 0 0; display: flex; flex-direction: column; gap: 0.35rem; }
  .place__hours div { display: grid; grid-template-columns: 10rem 1fr; }
  .place__hours dt { color: var(--muted); }
  .place__hours dd { margin: 0; }
  .place__actions { display: flex; flex-wrap: wrap; gap: 1.5rem; align-items: center; margin-top: 1rem; }
  @media (max-width: 48rem) {
    .story__copy, .how h2, .how__list, .place__copy, .place :global(.place__pic) { grid-column: 1 / -1; }
    .how__list { grid-template-columns: 1fr; }
    .place :global(.place__pic) { width: 70%; margin-left: auto; }
  }
</style>
