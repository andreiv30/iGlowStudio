---
// Paginile legale: Politica de confidențialitate, Termeni și condiții, Politica cookie.
// Textul se editează din /admin → Pagini legale.
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';

export async function getStaticPaths() {
  const pagini = await getCollection('pagini');
  return pagini.map((p) => ({ params: { pagina: p.id }, props: { p } }));
}
const { p } = Astro.props;
const { Content } = await render(p);
---
<Base title={p.data.titlu} description={p.data.descriere}>
  <article class="legal wrap">
    <header class="legal__head">
      <h1 class="head" data-load>{p.data.titlu}</h1>
      <p class="small muted" data-load style="--i: 1">Actualizat la {p.data.actualizat}</p>
    </header>
    <div class="prose legal__body" data-load style="--i: 2"><Content /></div>
  </article>
</Base>
<style>
  .legal { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); row-gap: 2.5rem; padding-block: clamp(3rem, 8vw, 7rem) var(--section); }
  .legal__head { grid-column: 1 / 5; display: flex; flex-direction: column; gap: 1rem; position: sticky; top: calc(var(--header-h) + 2rem); align-self: start; }
  .legal__body { grid-column: 6 / 13; }
  .legal__body :global(h2:first-child) { margin-top: 0; }
  @media (max-width: 56rem) { .legal__head, .legal__body { grid-column: 1 / -1; position: static; } }
</style>
