---
import { seoPagina, altImg } from '../lib/seo';
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import CtaCard from '../components/CtaCard.astro';
import acasa from '../data/acasa.json';
import { rezervaHref, rezervaExtern } from '../lib/nav';

const echipa = (await getCollection('echipa')).sort((a, b) => a.data.ordine - b.data.ordine);
const servicii = await getCollection('servicii');
const titlu = (slug: string) => servicii.find((s) => s.id === slug)?.data.titlu;
const membri = await Promise.all(echipa.map(async (m) => ({ m, Content: (await render(m)).Content })));
const ext = rezervaExtern ? { rel: 'noopener', target: '_blank' } : {};
---
<Base {...seoPagina('echipa')}>
  <!-- titlul și textul sunt aceleași ca în secțiunea Echipă de pe Acasă (/admin → Pagina Acasă) -->
  <PageHead eticheta="Echipă" titlu={acasa.echipa_titlu} text={acasa.echipa_text} />

  <div class="team-wrap section--glow">
    <section class="team container" aria-label="Membrii echipei">
      {membri.map(({ m, Content }, i) => (
        <article class="person" data-reveal style={`--i: ${i % 3}`}>
          <div class="person__media">
            <Photo src={m.data.foto} alt={altImg(`${m.data.nume}, ${m.data.rol}`)} ratio="4 / 5" rounded={false} />
            <span class="person__role">{m.data.rol}</span>
          </div>
          <div class="person__body">
            <h2 class="person__name">{m.data.nume}</h2>
            <div class="person__bio"><Content /></div>
            {m.data.servicii.length > 0 && (
              <ul class="person__tags" aria-label={`Servicii oferite de ${m.data.nume}`}>
                {m.data.servicii.map((slug) => titlu(slug) && <li><a href={`/servicii/${slug}/`}>{titlu(slug)}</a></li>)}
              </ul>
            )}
            <a class="btn btn--small btn--outline person__book" href={rezervaHref} {...ext}>Rezervă la {m.data.nume.split(' ')[0]} <Icon name="external" size={14} /></a>
          </div>
        </article>
      ))}
    </section>
  </div>

  <CtaCard />
</Base>

<style>
  .team-wrap { padding-block: clamp(3.5rem, 6vw, 5rem) clamp(4rem, 7vw, 6rem); }
  .team { display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 22rem)); gap: 1.75rem; justify-content: center; }
  .person { display: flex; flex-direction: column; overflow: hidden; border-radius: 22px; background: var(--alb); border: 1px solid rgb(177 139 90 / 0.16); box-shadow: 0 1px 2px rgb(26 19 13 / 0.04), 0 24px 48px -30px rgb(81 63 51 / 0.45); transition: transform 450ms var(--ease-out), box-shadow 450ms var(--ease-out); }
  .person__media { position: relative; overflow: hidden; }
  .person__media :global(.photo) { transition: transform 900ms var(--ease-out); }
  .person__media::after { content: ''; position: absolute; inset: auto 0 0 0; height: 45%; background: linear-gradient(0deg, rgb(26 19 13 / 0.55), transparent); pointer-events: none; }
  .person__role { position: absolute; left: 1.25rem; bottom: 1.1rem; z-index: 1; padding: 0.4rem 0.8rem; border-radius: 999px; background: rgb(255 255 255 / 0.18); border: 1px solid rgb(255 255 255 / 0.35); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); color: #fff; font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; }
  .person__body { display: flex; flex-direction: column; gap: 0.75rem; padding: 1.5rem 1.6rem 1.75rem; flex: 1; }
  .person__name { font-size: 1.75rem; line-height: 1.15; }
  .person__bio { color: var(--muted); font-size: 0.9375rem; }
  .person__bio :global(p + p) { margin-top: 0.6em; }
  .person__tags { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .person__tags a { display: inline-flex; align-items: center; min-height: 34px; padding: 0 0.8rem; border-radius: 999px; background: var(--surface); font-size: 0.8125rem; text-decoration: none; color: var(--taupe); transition: background-color 200ms ease, color 200ms ease; }
  .person__book { margin-top: auto; align-self: flex-start; }
  @media (any-hover: hover) {
    .person:hover { transform: translateY(-6px); box-shadow: 0 1px 2px rgb(26 19 13 / 0.04), 0 34px 60px -30px rgb(81 63 51 / 0.55); }
    .person:hover .person__media :global(.photo) { transform: scale(1.04); }
    .person__tags a:hover { background: var(--caramel); color: var(--espresso); }
  }
  @media (max-width: 40rem) { .team { grid-template-columns: 1fr; } }
</style>
