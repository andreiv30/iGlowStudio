---
import Base from '../layouts/Base.astro';
import Swatch from '../components/Swatch.astro';
---
<Base title="Pagina nu există" noindex>
  <section class="nf wrap">
    <div class="nf__copy">
      <h1 class="display" data-load>Pagina nu există</h1>
      <p class="lead" data-load style="--i: 1">Poate s-a mutat sau adresa are o greșeală. Te ducem înapoi.</p>
      <div class="nf__actions" data-load style="--i: 2"><a class="button" href="/">Pagina principală</a><a class="button button--quiet" href="/servicii">Servicii</a></div>
    </div>
    <div class="nf__hank" aria-hidden="true"><Swatch tone="greige" seed="404" /></div>
  </section>
</Base>
<style>
  .nf { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); align-items: center; padding-block: clamp(3rem, 8vw, 7rem) var(--section); }
  .nf__copy { grid-column: 1 / 9; display: flex; flex-direction: column; gap: 2rem; }
  .nf__actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }
  .nf__hank { grid-column: 10 / 13; }
  .nf__hank :global(.swatch) { height: 26rem; }
  @media (max-width: 48rem) { .nf__copy { grid-column: 1 / -1; } .nf__hank { display: none; } }
</style>
