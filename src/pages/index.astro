---
import { seoPagina, schemaFaq } from '../lib/seo';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import Faq from '../components/Faq.astro';
import CtaCard from '../components/CtaCard.astro';
import acasa from '../data/acasa.json';
import setari from '../data/setari.json';
import recenzii from '../data/recenzii.json';
import { accent, rezervaHref, rezervaExtern } from '../lib/nav';

const servicii = (await getCollection('servicii')).sort((a, b) => a.data.ordine - b.data.ordine);
const echipa = (await getCollection('echipa')).sort((a, b) => a.data.ordine - b.data.ordine);
const ext = rezervaExtern ? { rel: 'noopener', target: '_blank' } : {};
const initiale = (n: string) => n.replace(/[\[\]]/g, '').split(' ').map((p) => p[0] ?? '').join('').slice(0, 2).toUpperCase() || 'IG';
---
<Base {...seoPagina('acasa')} image={acasa.hero_imagine || undefined} schema={[schemaFaq(acasa.intrebari)]} overlay>
  <!-- Hero: poză mare pe tot ecranul (se încarcă din /admin), cu mișcare lentă -->
  <section class="hero on-photo" aria-labelledby="hero-title">
    <div class="hero__media" data-parallax>
      <div class="hero__zoom">
        {acasa.hero_imagine ? (
          <img src={acasa.hero_imagine} alt={acasa.hero_imagine_alt || ''} fetchpriority="high" />
        ) : (
          <div class="hero__empty" aria-hidden="true"></div>
        )}
      </div>
    </div>
    <div class="hero__shade" aria-hidden="true"></div>
    <div class="hero__content container">
      <p class="hero__label" data-load>{acasa.hero_eticheta}</p>
      <h1 id="hero-title" class="hero__title" data-load style="--i: 1" set:html={accent(acasa.hero_titlu)} />
      <a class="btn" href={rezervaHref} {...ext} data-load style="--i: 2">{acasa.hero_buton}</a>
    </div>
  </section>

  <!-- Banda cu cuvinte care se mișcă -->
  <div class="ribbon" aria-hidden="true">
    <div class="ribbon__track">
      {[0, 1].map(() => (
        <div class="ribbon__group">{acasa.cuvinte.map((c) => <span>{c}</span>)}</div>
      ))}
    </div>
  </div>

  <!-- De ce noi -->
  <section class="why section" aria-labelledby="why-title">
    <div class="container">
      <div class="head head--center">
        <p class="eyebrow eyebrow--center" data-reveal>{acasa.de_ce_eticheta}</p>
        <h2 id="why-title" class="h2" data-reveal style="--i: 1" set:html={accent(acasa.de_ce_titlu)} />
        <p class="lead" data-reveal style="--i: 2">{acasa.de_ce_text}</p>
      </div>
      <ul class="why__list">
        {acasa.de_ce.map((d, i) => (
          <li class="why__item" data-reveal style={`--i: ${i}`}>
            <span class="ring"><Icon name={d.icon} size={26} /></span>
            <h3 class="why__title">{d.titlu}</h3>
            <p class="why__text">{d.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Servicii: textul în stânga, cardurile într-un carusel în dreapta -->
  <section class="services section section--surface" aria-labelledby="services-title" data-carousel>
    <div class="container services__inner">
      <div class="services__intro head">
        <p class="eyebrow" data-reveal>Servicii</p>
        <h2 id="services-title" class="h2" data-reveal style="--i: 1" set:html={accent(acasa.servicii_titlu)} />
        <p class="lead" data-reveal style="--i: 2">{acasa.servicii_text}</p>
        <div class="services__actions" data-reveal style="--i: 3">
          <a class="btn btn--outline" href="/servicii">Vezi toate serviciile <Icon name="arrow" size={16} /></a>
          <div class="services__arrows">
            <button type="button" class="arrow" data-prev aria-label="Serviciul anterior"><Icon name="arrow-left" size={18} /></button>
            <button type="button" class="arrow" data-next aria-label="Serviciul următor"><Icon name="arrow" size={18} /></button>
          </div>
        </div>
      </div>
      <ul class="services__track" data-track>
        {servicii.map((s, i) => (
          <li class="svc card" data-reveal style={`--i: ${i}`}>
            <a class="svc__link" href={`/servicii/${s.id}`}>
              <Photo src={s.data.imagine} alt={s.data.imagine_alt} ratio="4 / 3" rounded={false} />
              <div class="svc__body">
                <p class="svc__label">{s.data.eticheta}</p>
                <h3 class="svc__name">{s.data.titlu}</h3>
                <p class="svc__text">{s.data.rezumat}</p>
                <span class="more">Descoperă <Icon name="arrow" size={14} /></span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Echipa -->
  <section class="team section" aria-labelledby="team-title">
    <div class="container">
      <div class="head head--center">
        <p class="eyebrow eyebrow--center" data-reveal>Echipă</p>
        <h2 id="team-title" class="h2" data-reveal style="--i: 1" set:html={accent(acasa.echipa_titlu)} />
        <p class="lead" data-reveal style="--i: 2">{acasa.echipa_text}</p>
      </div>
      <ul class:list={['team__grid', echipa.length === 1 && 'team__grid--single']}>
        {echipa.map((m, i) => (
          <li class="member card" data-reveal style={`--i: ${i}`}>
            <Photo src={m.data.foto} alt={`${m.data.nume}, ${m.data.rol}`} ratio="1 / 1" class="member__photo" />
            <div class="member__body">
              <h3 class="member__name">{m.data.nume}</h3>
              <p class="member__role">{m.data.rol}</p>
              <a class="more member__book" href={rezervaHref} {...ext}>Rezervă la {m.data.nume.split(' ')[0]} <Icon name="arrow" size={14} /></a>
            </div>
          </li>
        ))}
      </ul>
      <div class="team__more" data-reveal><a class="btn btn--outline" href="/echipa">Vezi toată echipa</a></div>
    </div>
  </section>

  <!-- Recenzii -->
  <section class="reviews section section--surface" aria-labelledby="reviews-title">
    <div class="container">
      <div class="reviews__score" data-reveal>
        <span class="reviews__g"><Icon name="google" size={30} /></span>
        <h2 id="reviews-title" class="sr-only">Recenzii</h2>
        <p class="reviews__nota">{recenzii.nota} <span class="reviews__star"><Icon name="star-fill" size={30} /></span></p>
        <p class="muted">{recenzii.numar} recenzii</p>
        <a class="more" href={recenzii.link_google} rel="noopener" target="_blank">Vezi profilul pe Google <Icon name="arrow-up-right" size={14} /></a>
      </div>
      <ul class="reviews__wall">
        {recenzii.recenzii.map((r, i) => (
          <li class="review card" data-reveal style={`--i: ${i % 3}`}>
            <div class="review__who">
              <span class="review__avatar">{initiale(r.nume)}</span>
              <span><strong>{r.nume}</strong><span class="review__stars" aria-label="5 stele">{[1, 2, 3, 4, 5].map(() => <Icon name="star-fill" size={13} />)}</span></span>
              <span class="review__date">{r.data}</span>
            </div>
            <p class="review__svc">{r.serviciu}</p>
            <blockquote>„{r.text}”</blockquote>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Întrebări frecvente -->
  <section class="faq-sec section" aria-labelledby="faq-title">
    <div class="container">
      <div class="head head--center faq-sec__head">
        <h2 id="faq-title" class="h2" data-reveal>Întrebări <em>frecvente</em></h2>
      </div>
      <Faq items={acasa.intrebari} />
    </div>
  </section>

  <CtaCard />
</Base>

<style>
  /* ---------- hero ---------- */
  .hero { position: relative; min-height: 100svh; display: flex; align-items: center; justify-content: center; overflow: hidden; background: var(--espresso); color: var(--alb-cald); }
  .hero__media { position: absolute; inset: -6% 0 0 0; will-change: transform; }
  .hero__zoom { position: absolute; inset: 0; }
  .hero__zoom img, .hero__empty { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hero__empty { background: var(--taupe); }
  /* mișcarea pozei: zoom lent, continuu (Ken Burns) + parallax la scroll din script */
  @media (prefers-reduced-motion: no-preference) {
    .hero__zoom { animation: kenburns 24s ease-in-out infinite alternate; transform-origin: 60% 40%; }
  }
  @keyframes kenburns { from { transform: scale(1.02) translate3d(0, 0, 0); } to { transform: scale(1.14) translate3d(-1.5%, -1%, 0); } }
  .hero__shade { position: absolute; inset: 0; background: rgb(26 19 13 / 0.45); }
  .hero__content { position: relative; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 1.75rem; padding-top: calc(var(--header-h) + var(--bar-h)); padding-bottom: 3rem; }
  .hero__label { font-size: 0.8125rem; font-weight: 500; letter-spacing: 0.36em; text-transform: uppercase; }
  .hero__title { font-size: clamp(2.6rem, 1.2rem + 5vw, 5.25rem); line-height: 1.05; max-width: 15ch; }

  /* ---------- banda cu cuvinte ---------- */
  .ribbon { background: var(--espresso); color: var(--auriu); overflow: hidden; padding-block: 1.1rem; border-top: 1px solid rgb(212 180 138 / 0.18); }
  .ribbon__track { display: flex; width: max-content; }
  .ribbon__group { display: flex; gap: 3.5rem; padding-right: 3.5rem; font-family: var(--font-display); font-style: italic; font-size: 1.375rem; white-space: nowrap; }
  @media (prefers-reduced-motion: no-preference) { .ribbon__track { animation: ribbon 38s linear infinite; } }
  @keyframes ribbon { to { transform: translateX(-50%); } }

  /* ---------- de ce noi (iconițe în cerc, ca pe flyer) ---------- */
  .why__list { list-style: none; padding: 0; margin-top: clamp(3rem, 5vw, 4.5rem); display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .why__item { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 0.6rem; padding: 0.5rem 1.5rem; }
  .why__item + .why__item { border-left: 1px solid rgb(177 139 90 / 0.4); }
  .why__item .ring { margin-bottom: 0.9rem; }
  .why__title { font-family: var(--font-text); font-size: 0.875rem; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; }
  .why__text { color: var(--muted); font-size: 0.9375rem; }

  /* ---------- servicii ---------- */
  .services__inner { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.6fr); gap: clamp(2rem, 4vw, 4rem); align-items: center; }
  .services__actions { display: flex; flex-direction: column; align-items: flex-start; gap: 1.5rem; margin-top: 0.75rem; }
  .services__arrows { display: flex; gap: 0.5rem; }
  .arrow { width: 3rem; height: 3rem; border-radius: 999px; background: var(--alb); box-shadow: var(--shadow); display: inline-flex; align-items: center; justify-content: center; transition: background-color 200ms ease, opacity 200ms ease; }
  .arrow:disabled { opacity: 0.35; cursor: default; }
  @media (hover: hover) and (pointer: fine) { .arrow:not(:disabled):hover { background: var(--caramel); } }
  .services__track { list-style: none; padding: 0.75rem 0.25rem 1.5rem; margin: 0; display: grid; grid-auto-flow: column; grid-auto-columns: calc((100% - 1.5rem) / 2); column-gap: 1.5rem; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
  .services__track::-webkit-scrollbar { display: none; }
  .svc { scroll-snap-align: start; overflow: hidden; }
  .svc__link { display: flex; flex-direction: column; height: 100%; text-decoration: none; }
  .svc__link :global(.photo) { transition: transform 600ms var(--ease-out); }
  .svc__body { padding: 1.5rem 1.75rem 1.25rem; display: flex; flex-direction: column; gap: 0.5rem; flex: 1; }
  .svc__label { display: flex; flex-direction: column; gap: 0.75rem; font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.24em; text-transform: uppercase; }
  .svc__label::before { content: ''; width: 2rem; height: 2px; background: var(--caramel); }
  .svc__name { font-size: 1.75rem; font-style: italic; }
  .svc__text { color: var(--muted); font-size: 0.9375rem; flex: 1; }
  @media (hover: hover) and (pointer: fine) { .svc__link:hover :global(.photo) { transform: scale(1.04); } }

  /* ---------- echipa ---------- */
  .team__grid { list-style: none; padding: 0; margin-top: clamp(3rem, 5vw, 4rem); display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; }
  .team__grid--single { grid-template-columns: minmax(0, 36rem); justify-content: center; }
  .member { display: grid; grid-template-columns: 11rem 1fr; gap: 1.75rem; align-items: center; padding: 1rem; }
  .member__body { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 0.25rem; }
  .member__name { font-size: 1.6rem; font-style: italic; }
  .member__role { color: var(--muted); font-size: 0.9375rem; }
  .member__book { margin-top: 0.5rem; }
  .team__more { display: flex; justify-content: center; margin-top: 2.5rem; }

  /* ---------- recenzii ---------- */
  .reviews__score { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 0.35rem; margin-bottom: 3rem; }
  .reviews__g { color: var(--taupe); margin-bottom: 0.5rem; }
  .reviews__nota { display: flex; align-items: center; gap: 0.6rem; font-family: var(--font-display); font-size: 3rem; line-height: 1; }
  .reviews__star { color: var(--caramel); display: inline-flex; }
  .reviews__wall { list-style: none; padding: 0; margin: 0; columns: 3 18rem; column-gap: 1.5rem; }
  .review { break-inside: avoid; margin-bottom: 1.5rem; padding: 1.5rem; display: flex; flex-direction: column; gap: 0.75rem; }
  .review__who { display: grid; grid-template-columns: auto 1fr auto; gap: 0.75rem; align-items: center; font-size: 0.875rem; }
  .review__who > span:nth-child(2) { display: flex; flex-direction: column; }
  .review__avatar { width: 2.5rem; height: 2.5rem; border-radius: 999px; background: var(--taupe); color: var(--alb-cald); display: inline-flex; align-items: center; justify-content: center; font-size: 0.8125rem; font-weight: 600; }
  .review__stars { display: flex; gap: 2px; color: var(--caramel); margin-top: 0.2rem; }
  .review__date { color: var(--muted); font-size: 0.75rem; }
  .review__svc { font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.22em; text-transform: uppercase; color: var(--taupe); }
  .review blockquote { color: var(--ink); font-size: 0.9375rem; }

  /* ---------- întrebări ---------- */
  .faq-sec__head { margin-bottom: 2.5rem; }

  /* ---------- tabletă și telefon ---------- */
  @media (max-width: 64rem) {
    .services__inner { grid-template-columns: 1fr; }
    .services__actions { flex-direction: row; flex-wrap: wrap; align-items: center; justify-content: space-between; width: 100%; }
    .why__list { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 2.5rem; }
    .why__item + .why__item:nth-child(3) { border-left: 0; }
    .team__grid { grid-template-columns: 1fr; }
    .team__grid--single { grid-template-columns: minmax(0, 36rem); }
  }
  @media (max-width: 40rem) {
    .services__track { grid-auto-columns: 85%; }
    .member { grid-template-columns: 1fr; text-align: center; }
    .why__item { padding-inline: 0.75rem; }
  }
</style>
