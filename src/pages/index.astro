---
import { seoPagina, schemaFaq, altImg } from '../lib/seo';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import Faq from '../components/Faq.astro';
import CtaCard from '../components/CtaCard.astro';
import acasa from '../data/acasa.json';
import setari from '../data/setari.json';
import recenzii from '../data/recenzii.json';
import { accent, rezervaHref, rezervaExtern } from '../lib/nav';

const servicii = (await getCollection('servicii')).sort((a, b) => a.data.ordine - b.data.ordine);
const echipa = (await getCollection('echipa')).sort((a, b) => a.data.ordine - b.data.ordine);
const ext = rezervaExtern ? { rel: 'noopener', target: '_blank' } : {};
// banda cu cuvinte: destule cuvinte cât să acopere orice ecran, ca bucla să nu lase gol
const cuvinteBanda = Array.from({ length: Math.max(1, Math.ceil(16 / Math.max(1, acasa.cuvinte.length))) }, () => acasa.cuvinte).flat();
const durataBanda = `${Math.round(cuvinteBanda.length * 2.4)}s`;
const initiale = (n: string) => n.replace(/[\[\]]/g, '').split(' ').map((p) => p[0] ?? '').join('').slice(0, 2).toUpperCase() || 'IG';
---
<Base {...seoPagina('acasa')} image={acasa.hero_imagine || undefined} schema={[schemaFaq(acasa.intrebari)]} overlay>
  <!-- Hero: poză mare pe tot ecranul (se încarcă din /admin), cu mișcare lentă -->
  <section class="hero on-photo" aria-labelledby="hero-title">
    <div class="hero__media" data-parallax>
      <div class="hero__zoom">
        {acasa.hero_imagine ? (
          <img src={acasa.hero_imagine} alt={altImg('Coafură și culoare', acasa.hero_imagine_alt)} fetchpriority="high" />
        ) : (
          <div class="hero__empty" aria-hidden="true"></div>
        )}
      </div>
    </div>
    <div class="hero__shade" aria-hidden="true"></div>
    <div class="hero__content container">
      <h1 id="hero-title" class="hero__label" data-load>{acasa.hero_eticheta}</h1>
      <p class="hero__title" data-load style="--i: 1" set:html={accent(acasa.hero_titlu)} />
      <a class="btn" href={rezervaHref} {...ext} data-load style="--i: 2">{acasa.hero_buton} <Icon name="external" size={16} /></a>
    </div>
  </section>

  <!-- Banda cu cuvinte care se mișcă, în buclă continuă, pe fundal închis cu lumini calde -->
  <div class="ribbon" aria-hidden="true">
    <span class="ribbon__glow ribbon__glow--a"></span>
    <span class="ribbon__glow ribbon__glow--b"></span>
    <span class="ribbon__glow ribbon__glow--c"></span>
    <div class="ribbon__mask">
      <div class="ribbon__track" style={`--dur: ${durataBanda}`}>
        {[0, 1].map(() => (
          <div class="ribbon__group">
            {cuvinteBanda.map((c) => <><span class="ribbon__word">{c}</span><span class="ribbon__dot"><Icon name="spark" size={11} /></span></>)}
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- De ce noi -->
  <section class="why section" aria-labelledby="why-title">
    <div class="container">
      <div class="why__head">
        <div class="head">
          <p class="eyebrow" data-reveal>{acasa.de_ce_eticheta}</p>
          <h2 id="why-title" class="h2" data-reveal style="--i: 1" set:html={accent(acasa.de_ce_titlu)} />
        </div>
        <p class="lead why__lead" data-reveal style="--i: 2">{acasa.de_ce_text}</p>
      </div>
      <ol class="why__steps">
        {acasa.de_ce.map((d, i) => (
          <li class="step" data-reveal style={`--i: ${i}`}>
            <span class="step__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="step__icon"><Icon name={d.icon} size={24} /></span>
            <h3 class="step__title">{d.titlu}</h3>
            <p class="step__text">{d.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Servicii: titlul și săgețile sus, dedesubt caruselul pe toată lățimea (3 carduri, cu drag pe desktop) -->
  <section class="services section section--surface" aria-labelledby="services-title" data-carousel>
    <div class="container">
      <div class="services__head">
        <div class="head">
          <p class="eyebrow" data-reveal>Servicii</p>
          <h2 id="services-title" class="h2" data-reveal style="--i: 1" set:html={accent(acasa.servicii_titlu)} />
        </div>
        <div class="services__side" data-reveal style="--i: 2">
          <p class="lead">{acasa.servicii_text}</p>
          <div class="services__actions">
            <a class="btn btn--outline" href="/servicii">Vezi toate serviciile <Icon name="arrow" size={16} /></a>
            <div class="services__arrows">
              <button type="button" class="arrow" data-prev aria-label="Serviciul anterior"><Icon name="arrow-left" size={18} /></button>
              <button type="button" class="arrow" data-next aria-label="Serviciul următor"><Icon name="arrow" size={18} /></button>
            </div>
          </div>
        </div>
      </div>
      <ul class="services__track" data-track data-drag>
        {servicii.map((s, i) => (
          <li class="svc card" data-reveal style={`--i: ${i}`}>
            <a class="svc__link" href={`/servicii/${s.id}`}>
              <Photo src={s.data.imagine} alt={altImg(s.data.titlu, s.data.imagine_alt)} ratio="4 / 3" rounded={false} />
              <div class="svc__body">
                <p class="svc__label">{s.data.eticheta}</p>
                <h3 class="svc__name">{s.data.titlu}</h3>
                <p class="svc__text">{s.data.rezumat}</p>
                <span class="more">Descoperă <Icon name="arrow" size={14} /></span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Echipa -->
  <section class="team section" aria-labelledby="team-title">
    <div class="container">
      <div class="head head--center">
        <p class="eyebrow eyebrow--center" data-reveal>Echipă</p>
        <h2 id="team-title" class="h2" data-reveal style="--i: 1" set:html={accent(acasa.echipa_titlu)} />
        <p class="lead" data-reveal style="--i: 2">{acasa.echipa_text}</p>
      </div>
      <ul class:list={['team__grid', echipa.length === 1 && 'team__grid--single']}>
        {echipa.map((m, i) => (
          <li class="member card" data-reveal style={`--i: ${i}`}>
            <Photo src={m.data.foto} alt={altImg(`${m.data.nume}, ${m.data.rol}`)} ratio="1 / 1" class="member__photo" />
            <div class="member__body">
              <h3 class="member__name">{m.data.nume}</h3>
              <p class="member__role">{m.data.rol}</p>
              <a class="more member__book" href={rezervaHref} {...ext}>Rezervă la {m.data.nume.split(' ')[0]} <Icon name="external" size={14} /></a>
            </div>
          </li>
        ))}
      </ul>
      <div class="team__more" data-reveal><a class="btn btn--outline" href="/echipa">Vezi toată echipa</a></div>
    </div>
  </section>

  <!-- Recenzii: coloane care urcă încet, cu blur sus și jos (scriptul construiește coloanele) -->
  <section class="reviews section section--surface" aria-labelledby="reviews-title">
    <div class="container">
      <div class="reviews__head head head--center">
        <p class="eyebrow eyebrow--center" data-reveal>Recenzii</p>
        <h2 id="reviews-title" class="h2" data-reveal style="--i: 1">Ce spun <em>clientele noastre</em></h2>
        <div class="reviews__score" data-reveal style="--i: 2">
          <p class="reviews__nota">{recenzii.nota}</p>
          <div>
            <span class="reviews__stars" aria-label="5 din 5 stele">{[1, 2, 3, 4, 5].map(() => <Icon name="star-fill" size={16} />)}</span>
            <p class="reviews__count">{recenzii.numar} recenzii verificate pe {recenzii.sursa}</p>
          </div>
          <a class="more" href={recenzii.link} rel="noopener" target="_blank">Vezi toate <Icon name="arrow-up-right" size={14} /></a>
        </div>
      </div>
      <div class="marquee" data-marquee>
        <div class="marquee__viewport">
          <ul class="marquee__list" data-marquee-list>
            {recenzii.recenzii.map((r, i) => (
              <li class:list={["rv", `rv--t${i % 3}`]}>
                <div class="rv__who">
                  <span class="rv__avatar" aria-hidden="true">{initiale(r.nume)}</span>
                  <div>
                    <p class="rv__name">{r.nume} <span class="rv__badge">Verificat</span></p>
                    <p class="rv__meta"><span class="rv__stars" aria-label="5 stele">{[1, 2, 3, 4, 5].map(() => <Icon name="star-fill" size={13} />)}</span>{r.data}</p>
                  </div>
                </div>
                <p class="rv__svc">{r.serviciu}</p>
                <blockquote class="rv__text">„{r.text}”</blockquote>
                <a class="rv__link" href={recenzii.link} rel="noopener" target="_blank">Vezi pe {recenzii.sursa} <Icon name="arrow-up-right" size={13} /></a>
              </li>
            ))}
          </ul>
        </div>
        <button type="button" class="marquee__toggle" data-marquee-toggle aria-pressed="false">
          <span class="marquee__pause"><Icon name="pause" size={16} /></span><span class="marquee__play"><Icon name="play" size={16} /></span>
          <span data-marquee-label>Oprește derularea</span>
        </button>
      </div>
    </div>
  </section>

  <!-- Întrebări frecvente -->
  <section class="faq-sec section" aria-labelledby="faq-title">
    <div class="container">
      <div class="head head--center faq-sec__head">
        <h2 id="faq-title" class="h2" data-reveal>Întrebări <em>frecvente</em></h2>
      </div>
      <Faq items={acasa.intrebari} />
    </div>
  </section>

  <CtaCard />
</Base>

<style>
  /* ---------- hero ---------- */
  .hero { position: relative; min-height: 100svh; display: flex; align-items: center; justify-content: center; overflow: hidden; background: var(--espresso); color: var(--alb-cald); }
  .hero__media { position: absolute; inset: -6% 0 0 0; will-change: transform; }
  .hero__zoom { position: absolute; inset: 0; }
  .hero__zoom img, .hero__empty { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hero__empty { background: var(--taupe); }
  /* mișcarea pozei: zoom lent, continuu (Ken Burns) + parallax la scroll din script */
  @media (prefers-reduced-motion: no-preference) {
    .hero__zoom { animation: kenburns 24s ease-in-out infinite alternate; transform-origin: 60% 40%; }
  }
  @keyframes kenburns { from { transform: scale(1.02) translate3d(0, 0, 0); } to { transform: scale(1.14) translate3d(-1.5%, -1%, 0); } }
  .hero__shade { position: absolute; inset: 0; background: rgb(26 19 13 / 0.45); }
  .hero__content { position: relative; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 1.75rem; padding-top: calc(var(--header-h) + var(--bar-h)); padding-bottom: 3rem; }
  /* h1 = eticheta mică (pentru Google), stilul rămâne cel al etichetei; titlul mare e paragraf, cu stil de titlu */
  .hero__label { font-family: var(--font-text); font-size: 0.8125rem; font-weight: 500; line-height: 1.65; letter-spacing: 0.36em; text-transform: uppercase; text-wrap: wrap; }
  .hero__title { font-family: var(--font-display); font-weight: 400; letter-spacing: -0.01em; text-wrap: balance; font-size: clamp(2.6rem, 1.2rem + 5vw, 5.25rem); line-height: 1.05; max-width: 15ch; }
  .hero__title :global(em) { font-style: italic; color: var(--auriu); }

  /* ---------- banda cu cuvinte: buclă continuă pe fundal închis, cu lumini calde ---------- */
  .ribbon { position: relative; overflow: hidden; isolation: isolate; padding-block: clamp(0.85rem, 1.4vw, 1.15rem); background: radial-gradient(70% 160% at 50% 130%, rgb(177 139 90 / 0.22), transparent 60%), linear-gradient(180deg, #1f1710, var(--espresso)); color: var(--auriu); border-block: 1px solid rgb(212 180 138 / 0.16); }
  .ribbon__glow { position: absolute; z-index: -1; border-radius: 999px; filter: blur(30px); pointer-events: none; }
  .ribbon__glow--a { width: 26rem; height: 6rem; left: -6rem; top: -2.5rem; background: radial-gradient(closest-side, rgb(212 180 138 / 0.42), transparent); }
  .ribbon__glow--b { width: 22rem; height: 5.5rem; right: 8%; bottom: -2.75rem; background: radial-gradient(closest-side, rgb(177 139 90 / 0.5), transparent); }
  .ribbon__glow--c { width: 16rem; height: 4.5rem; left: 42%; top: -2rem; background: radial-gradient(closest-side, rgb(243 227 200 / 0.22), transparent); }
  .ribbon__mask { -webkit-mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent); mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent); }
  .ribbon__track { display: flex; width: max-content; }
  .ribbon__group { display: flex; align-items: center; gap: clamp(1.1rem, 2vw, 1.75rem); padding-right: clamp(1.1rem, 2vw, 1.75rem); flex: none; white-space: nowrap; }
  .ribbon__word { font-family: var(--font-display); font-style: italic; font-size: clamp(1.1rem, 0.98rem + 0.45vw, 1.4rem); line-height: 1.25; background: linear-gradient(100deg, #c9a574 0%, #f3e3c8 45%, #c9a574 90%); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .ribbon__dot { display: inline-flex; color: var(--caramel); opacity: 0.85; }
  @media (prefers-reduced-motion: no-preference) {
    .ribbon__track { animation: ribbon var(--dur, 40s) linear infinite; }
    .ribbon__glow--a { animation: drift 16s ease-in-out infinite alternate; }
    .ribbon__glow--b { animation: drift 19s ease-in-out infinite alternate-reverse; }
    .ribbon__glow--c { animation: drift 13s ease-in-out infinite alternate; }
  }
  @keyframes ribbon { to { transform: translate3d(-50%, 0, 0); } }
  @keyframes drift { to { transform: translate3d(18vw, 1.5rem, 0) scale(1.15); } }

  /* ---------- de ce noi: patru pași, ca un traseu ---------- */
  .why__head { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: clamp(1.5rem, 4vw, 4rem); align-items: end; }
  .why__lead { padding-bottom: 0.35rem; }
  .why__steps { list-style: none; padding: 2.75rem 0 0; margin: clamp(2.5rem, 5vw, 4rem) 0 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.25rem; position: relative; }
  .why__steps::before { content: ''; position: absolute; left: 0; right: 0; top: 0.6rem; height: 1px; background: linear-gradient(90deg, transparent, rgb(177 139 90 / 0.55) 12%, rgb(177 139 90 / 0.55) 88%, transparent); }
  .step { position: relative; display: flex; flex-direction: column; gap: 0.7rem; padding: 2rem 1.75rem 2.25rem; border-radius: 20px; background: linear-gradient(180deg, rgb(255 255 255 / 0.95), rgb(251 247 243 / 0.95)); border: 1px solid rgb(177 139 90 / 0.18); box-shadow: 0 1px 2px rgb(26 19 13 / 0.03), 0 18px 40px -28px rgb(81 63 51 / 0.35); transition: transform 400ms var(--ease-out), box-shadow 400ms var(--ease-out), border-color 300ms ease; }
  .step::before { content: ''; position: absolute; top: -2.55rem; left: 1.9rem; width: 0.75rem; height: 0.75rem; border-radius: 999px; background: var(--bg); border: 2px solid var(--caramel); box-shadow: 0 0 0 5px rgb(177 139 90 / 0.12); }
  .step::after { content: ''; position: absolute; left: 1.75rem; right: 1.75rem; bottom: 0; height: 2px; border-radius: 2px; background: linear-gradient(90deg, var(--caramel), var(--auriu)); transform: scaleX(0); transform-origin: left; transition: transform 500ms var(--ease-out); }
  .step__num { position: absolute; top: 1.1rem; right: 1.4rem; font-family: var(--font-display); font-style: italic; font-size: 3.25rem; line-height: 1; color: transparent; -webkit-text-stroke: 1px rgb(177 139 90 / 0.45); pointer-events: none; }
  .step__icon { width: 3.25rem; height: 3.25rem; border-radius: 14px; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 0.85rem; color: var(--taupe); background: linear-gradient(135deg, rgb(212 180 138 / 0.32), rgb(177 139 90 / 0.1)); border: 1px solid rgb(177 139 90 / 0.25); transition: background-color 300ms ease, color 300ms ease; }
  .step__title { font-size: 1.45rem; line-height: 1.2; }
  .step__text { color: var(--muted); font-size: 0.9375rem; }
  .step__text::first-letter { text-transform: uppercase; }
  @media (hover: hover) and (pointer: fine) {
    .step:hover { transform: translateY(-6px); border-color: rgb(177 139 90 / 0.4); box-shadow: 0 1px 2px rgb(26 19 13 / 0.04), 0 28px 50px -26px rgb(81 63 51 / 0.45); }
    .step:hover::after { transform: scaleX(1); }
    .step:hover .step__icon { background: var(--caramel-btn); color: #fff; }
  }

  /* ---------- servicii: antet sus, carusel cu 3 carduri dedesubt ---------- */
  .services__head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(1.5rem, 4vw, 4rem); align-items: end; }
  .services__side { display: flex; flex-direction: column; gap: 1.5rem; }
  .services__actions { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; }
  .services__arrows { display: flex; gap: 0.5rem; }
  .arrow { width: 3rem; height: 3rem; border-radius: 999px; background: var(--alb); box-shadow: var(--shadow); display: inline-flex; align-items: center; justify-content: center; transition: background-color 200ms ease, color 200ms ease, opacity 200ms ease; }
  .arrow:disabled { opacity: 0.35; cursor: default; }
  @media (hover: hover) and (pointer: fine) { .arrow:not(:disabled):hover { background: var(--caramel-btn); color: #fff; } }
  .services__track { list-style: none; margin: clamp(2.5rem, 4vw, 3.5rem) -0.75rem 0; padding: 0.75rem 0.75rem 1.75rem; display: grid; grid-auto-flow: column; grid-auto-columns: calc((100% - 3rem) / 3); column-gap: 1.5rem; overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scroll-padding-inline: 0.75rem; scrollbar-width: none; }
  .services__track::-webkit-scrollbar { display: none; }
  @media (hover: hover) and (pointer: fine) { .services__track { cursor: grab; } }
  .services__track.is-dragging { cursor: grabbing; scroll-snap-type: none; user-select: none; }
  .services__track.is-dragging a { pointer-events: none; }
  .svc { scroll-snap-align: start; overflow: hidden; }
  .svc__link { display: flex; flex-direction: column; height: 100%; text-decoration: none; -webkit-user-drag: none; }
  .svc__link :global(img) { -webkit-user-drag: none; user-select: none; }
  .svc__link :global(.photo) { transition: transform 600ms var(--ease-out); }
  .svc__body { padding: 1.5rem 1.75rem 1.25rem; display: flex; flex-direction: column; gap: 0.5rem; flex: 1; }
  .svc__label { display: flex; flex-direction: column; gap: 0.75rem; font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.24em; text-transform: uppercase; }
  .svc__label::before { content: ''; width: 2rem; height: 2px; background: var(--caramel); }
  .svc__name { font-size: 1.75rem; font-style: italic; }
  .svc__text { color: var(--muted); font-size: 0.9375rem; flex: 1; }
  @media (hover: hover) and (pointer: fine) { .svc__link:hover :global(.photo) { transform: scale(1.04); } }

  /* ---------- echipa ---------- */
  .team__grid { list-style: none; padding: 0; margin-top: clamp(3rem, 5vw, 4rem); display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; }
  .team__grid--single { grid-template-columns: minmax(0, 36rem); justify-content: center; }
  .member { display: grid; grid-template-columns: 11rem 1fr; gap: 1.75rem; align-items: center; padding: 1rem; }
  .member__body { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 0.25rem; }
  .member__name { font-size: 1.6rem; font-style: italic; }
  .member__role { color: var(--muted); font-size: 0.9375rem; }
  .member__book { margin-top: 0.5rem; }
  .team__more { display: flex; justify-content: center; margin-top: 2.5rem; }

  /* ---------- recenzii: coloane care urcă, cu blur și estompare sus și jos ---------- */
  .reviews__head { margin-bottom: clamp(2.5rem, 4vw, 3.5rem); }
  .reviews__score { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 0.75rem 1.25rem; margin-top: 0.5rem; padding: 0.75rem 0.75rem 0.75rem 1.5rem; border-radius: 999px; background: var(--alb); box-shadow: var(--shadow); }
  .reviews__nota { font-family: var(--font-display); font-size: 2.4rem; line-height: 1; }
  .reviews__stars { display: flex; gap: 2px; color: var(--caramel); }
  .reviews__count { font-size: 0.8125rem; color: var(--muted); text-align: left; }
  .reviews__score .more { padding-inline: 0.75rem; }

  .marquee { position: relative; }
  .marquee__viewport { position: relative; height: clamp(34rem, 70vh, 46rem); overflow: hidden; -webkit-mask-image: linear-gradient(180deg, transparent 0, #000 16%, #000 84%, transparent 100%); mask-image: linear-gradient(180deg, transparent 0, #000 16%, #000 84%, transparent 100%); }
  .marquee::before, .marquee::after { content: ''; position: absolute; left: 0; right: 0; z-index: 2; height: 24%; pointer-events: none; -webkit-backdrop-filter: blur(5px); backdrop-filter: blur(5px); }
  .marquee::before { top: 0; -webkit-mask-image: linear-gradient(180deg, #000 20%, transparent); mask-image: linear-gradient(180deg, #000 20%, transparent); }
  .marquee::after { bottom: 0; -webkit-mask-image: linear-gradient(0deg, #000 20%, transparent); mask-image: linear-gradient(0deg, #000 20%, transparent); }
  .marquee__list { list-style: none; padding: 0; margin: 0; columns: 3 18rem; column-gap: 1.5rem; }
  .marquee__list .rv { break-inside: avoid; margin-bottom: 1.5rem; }
  .marquee.is-built .marquee__list { display: none; }
  .marquee :global(.marquee__cols) { display: grid; grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr)); gap: 1.5rem; height: 100%; }
  .marquee :global(.marquee__col) { overflow: hidden; }
  .marquee :global(.marquee__inner) { display: flex; flex-direction: column; will-change: transform; animation: marquee-up var(--dur, 60s) linear infinite; animation-delay: var(--delay, 0s); }
  .marquee :global(.marquee__group) { display: flex; flex-direction: column; gap: 1.5rem; padding-bottom: 1.5rem; }
  .marquee.is-paused :global(.marquee__inner) { animation-play-state: paused; }
  @keyframes marquee-up { to { transform: translate3d(0, -50%, 0); } }

