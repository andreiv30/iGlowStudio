---
// Șablonul paginii unui serviciu. Conținutul vine din src/content/servicii/<slug>.md
// și se editează din /admin → Servicii. Exemplul de referință: /servicii/tuns.
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import Icon from '../../components/Icon.astro';
import PriceCard from '../../components/PriceCard.astro';
import Faq from '../../components/Faq.astro';
import CtaCard from '../../components/CtaCard.astro';
import { rezervaHref, rezervaExtern } from '../../lib/nav';
import { schemaBreadcrumb, schemaFaq } from '../../lib/seo';
import setari from '../../data/setari.json';

export async function getStaticPaths() {
  const servicii = (await getCollection('servicii')).sort((a, b) => a.data.ordine - b.data.ordine);
  return servicii.map((s) => ({ params: { slug: s.id }, props: { s, toate: servicii } }));
}

const { s, toate } = Astro.props;
const { Content } = await render(s);
const altele = toate.filter((x) => x.id !== s.id);
const ext = rezervaExtern ? { rel: 'noopener', target: '_blank' } : {};
const site = Astro.site!;
const schema = [
  schemaBreadcrumb(site, [
    { name: 'Acasă', path: '/' },
    { name: 'Servicii', path: '/servicii/' },
    { name: s.data.titlu, path: `/servicii/${s.id}/` },
  ]),
  schemaFaq(s.data.intrebari),
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: s.data.titlu,
    description: s.data.rezumat,
    serviceType: s.data.titlu,
    url: new URL(`/servicii/${s.id}/`, site).toString(),
    provider: { '@id': new URL('/#salon', site).toString() },
    areaServed: setari.oras && !/^\[/.test(setari.oras) ? setari.oras : undefined,
    offers: { '@type': 'Offer', price: s.data.pret_de_la, priceCurrency: 'RON', url: new URL(`/servicii/${s.id}/`, site).toString() },
  },
];
const pasIcon = ['search', 'drop', 'scissors', 'star', 'diamond', 'sparkle'];
---
<Base title={s.data.seo_titlu || `${s.data.titlu} – prețuri și programare`} description={s.data.seo_descriere || s.data.rezumat} image={s.data.imagine} schema={schema}>
  <!-- începutul: text în stânga, poza serviciului în dreapta -->
  <section class="svc-head">
    <div class="container svc-head__inner">
      <div class="svc-head__copy head">
        <nav class="crumbs" aria-label="Unde te afli" data-load><a href="/servicii">Servicii</a><span aria-hidden="true">/</span><span aria-current="page">{s.data.titlu}</span></nav>
        <p class="eyebrow" data-load>{s.data.eticheta}</p>
        <h1 class="h1" data-load style="--i: 1"><em>{s.data.titlu}</em></h1>
        <p class="lead" data-load style="--i: 2">{s.data.rezumat}</p>
        <dl class="facts" data-load style="--i: 3">
          <div><dt><Icon name="clock" size={16} />Durată</dt><dd>{s.data.durata}</dd></div>
          <div><dt><Icon name="calendar" size={16} />Preț</dt><dd>de la {s.data.pret_de_la} lei</dd></div>
        </dl>
        <div class="svc-head__actions" data-load style="--i: 4">
          <a class="btn" href={rezervaHref} {...ext}>Programează-te <Icon name="arrow" size={16} /></a>
          <a class="btn btn--outline" href="#preturi">Vezi prețurile</a>
        </div>
      </div>
      <div data-load style="--i: 2"><Photo src={s.data.imagine} alt={s.data.imagine_alt} ratio="4 / 5" eager /></div>
    </div>
  </section>

  <!-- cum lucrăm: pașii, cu iconițe în cerc pe fundal închis (stilul flyerului) -->
  {s.data.pasi.length > 0 && (
    <section class="steps section section--dark" aria-labelledby="steps-title">
      <div class="container">
        <div class="head head--center">
          <p class="eyebrow eyebrow--center" data-reveal>Cum lucrăm</p>
          <h2 id="steps-title" class="h2" data-reveal style="--i: 1">Pas cu pas, <em>fără grabă</em></h2>
        </div>
        <ol class="steps__list">
          {s.data.pasi.map((p, i) => (
            <li class="steps__item" data-reveal style={`--i: ${i}`}>
              <span class="ring"><Icon name={pasIcon[i % pasIcon.length]} size={24} /></span>
              <h3 class="steps__title">{p.titlu}</h3>
              <p>{p.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  <!-- despre serviciu: textul din /admin, lângă o a doua poză -->
  <section class="about section" aria-labelledby="about-title">
    <div class="container about__inner">
      <div data-reveal><Photo src={s.data.imagine_detaliu} alt={s.data.imagine_alt} ratio="1 / 1" /></div>
      <div class="head">
        <p class="eyebrow" data-reveal>Despre serviciu</p>
        <h2 id="about-title" class="h2" data-reveal style="--i: 1">Ce înseamnă <em>{s.data.titlu.toLowerCase()}</em> la iGlow</h2>
        <div class="prose" data-reveal style="--i: 2"><Content /></div>
      </div>
    </div>
  </section>

  <!-- prețuri -->
  {s.data.preturi.length > 0 && (
    <section class="prices section section--surface" id="preturi" aria-labelledby="prices-title">
      <div class="container">
        <div class="head head--center">
          <p class="eyebrow eyebrow--center" data-reveal>Prețuri</p>
          <h2 id="prices-title" class="h2" data-reveal style="--i: 1">Prețuri pentru <em>{s.data.titlu.toLowerCase()}</em></h2>
        </div>
        <div class="prices__grid">
          {s.data.preturi.map((p, i) => <PriceCard nume={p.nume} descriere={p.descriere} durata={p.durata} pret={p.pret} i={i % 3} />)}
        </div>
      </div>
    </section>
  )}

  <!-- întrebări -->
  {s.data.intrebari.length > 0 && (
    <section class="section" aria-labelledby="q-title">
      <div class="container">
        <div class="head head--center q-head">
          <h2 id="q-title" class="h2" data-reveal>Întrebări <em>frecvente</em></h2>
        </div>
        <Faq items={s.data.intrebari} />
      </div>
    </section>
  )}

  <!-- alte servicii -->
  <section class="others section section--surface" aria-labelledby="others-title">
    <div class="container">
      <div class="head head--center">
        <p class="eyebrow eyebrow--center" data-reveal>Servicii</p>
        <h2 id="others-title" class="h2" data-reveal style="--i: 1">Poate te interesează <em>și</em></h2>
      </div>
      <ul class="others__grid">
        {altele.map((o, i) => (
          <li class="card others__card" data-reveal style={`--i: ${i}`}>
            <a href={`/servicii/${o.id}`}>
              <Photo src={o.data.imagine} alt="" ratio="4 / 3" rounded={false} />
              <span class="others__body">
                <span class="others__label">{o.data.eticheta}</span>
                <span class="others__name">{o.data.titlu}</span>
                <span class="more">Descoperă <Icon name="arrow" size={14} /></span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaCard titlu={`Rezervă *${s.data.titlu.toLowerCase()}*`} />
</Base>

<style>
  .svc-head { padding-top: calc(var(--header-h) + var(--bar-h) + clamp(2rem, 5vw, 4rem)); padding-bottom: var(--section); background: var(--surface); }
  .svc-head__inner { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  .crumbs { display: flex; gap: 0.6rem; font-size: 0.8125rem; color: var(--muted); }
  .crumbs a { color: inherit; text-underline-offset: 3px; }
  .facts { display: flex; flex-wrap: wrap; gap: 1rem; margin: 0.5rem 0; }
  .facts div { background: var(--alb); border-radius: var(--radius-sm); padding: 0.9rem 1.25rem; box-shadow: var(--shadow); }
  .facts dt { display: flex; align-items: center; gap: 0.4rem; font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.22em; text-transform: uppercase; color: var(--muted); }
  .facts dd { margin: 0.25rem 0 0; font-family: var(--font-display); font-size: 1.4rem; }
  .svc-head__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }

  .steps__list { list-style: none; padding: 0; margin-top: clamp(3rem, 5vw, 4rem); display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .steps__item { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 0.75rem; padding: 0.5rem 1.5rem; }
  .steps__item + .steps__item { border-left: 1px solid rgb(177 139 90 / 0.35); }
  .steps__item .ring { margin-bottom: 0.75rem; }
  .steps__title { font-family: var(--font-text); font-size: 0.875rem; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; }
  .steps__item p { color: var(--nisip); font-size: 0.9375rem; }

  .about__inner { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(2rem, 5vw, 5rem); align-items: center; }

  .prices__grid { margin-top: 3rem; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; }
  .q-head { margin-bottom: 2.5rem; }

  .others__grid { list-style: none; padding: 0; margin-top: 3rem; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.5rem; }
  .others__card { overflow: hidden; }
  .others__card a { display: flex; flex-direction: column; text-decoration: none; height: 100%; }
  .others__body { display: flex; flex-direction: column; gap: 0.35rem; padding: 1.25rem 1.5rem 1rem; }
  .others__label { font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.22em; text-transform: uppercase; color: var(--muted); }
  .others__name { font-family: var(--font-display); font-style: italic; font-size: 1.5rem; }

  @media (max-width: 64rem) {
    .steps__list { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 2.5rem; }
    .steps__item + .steps__item:nth-child(3) { border-left: 0; }
    .prices__grid, .others__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 48rem) {
    .svc-head__inner, .about__inner { grid-template-columns: 1fr; }
  }
  @media (max-width: 40rem) {
    .steps__list, .prices__grid { grid-template-columns: 1fr; }
    .steps__item + .steps__item { border-left: 0; }
  }
</style>
