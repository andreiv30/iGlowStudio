---
// O imagine: fotografia încărcată din /admin, sau, până atunci, o mostră de păr desenată în tonul elementului.
import Swatch from './Swatch.astro';
interface Props {
  src?: string | null;
  alt?: string | null;
  tone?: string;
  seed?: string;
  variant?: 'hank' | 'closeup';
  ratio?: string;
  eager?: boolean;
  shutter?: boolean;
  i?: number;
  class?: string;
  label?: string;
  width?: number;
  height?: number;
}
const { src, alt = '', tone = 'caramel', seed, variant = 'hank', ratio = '4 / 5', eager = false, shutter = true, i = 0, class: cls, label, width = 1200, height = 1500 } = Astro.props;
---
<figure class:list={['media', !src && `tone-${tone}`, !src && `media--${variant}`, cls]} style={`--ratio: ${ratio}; --i: ${i}`} data-shutter={shutter ? '' : undefined}>
  <div class="media__inner">
    {src ? (
      <img src={src} alt={alt ?? ''} width={width} height={height} loading={eager ? 'eager' : 'lazy'} decoding="async" />
    ) : (
      <div class="media__draw">
        <Swatch tone={tone} seed={seed} variant={variant} label={label} />
      </div>
    )}
  </div>
</figure>
<style>
  .media { position: relative; aspect-ratio: var(--ratio); margin: 0; }
  .media__inner { position: absolute; inset: 0; overflow: hidden; background: var(--surface); border-radius: var(--radius); }
  .media img { width: 100%; height: 100%; object-fit: cover; }
  .media--closeup .media__inner { background: var(--tone); }
  .media--hank .media__draw { position: absolute; inset: 8% 0 4%; }
  .media--closeup .media__draw { position: absolute; inset: 0; }
  .media__draw { width: 100%; height: 100%; }
</style>
