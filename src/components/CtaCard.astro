---
// „Pasul următor”: cardul de la finalul paginilor, ca pe Caracter.
import Icon from './Icon.astro';
import { accent, rezervaHref, rezervaExtern } from '../lib/nav';
interface Props { titlu?: string; text?: string }
const { titlu = 'Pregătită pentru *noul tău look*?', text = 'Alege serviciul și ora care ți se potrivesc. Îți confirmăm programarea cât mai repede.' } = Astro.props;
const ext = rezervaExtern ? { rel: 'noopener', target: '_blank' } : {};
---
<section class="cta container" aria-labelledby="cta-title">
  <div class="cta__card card" data-reveal>
    <p class="eyebrow eyebrow--center">Pasul următor</p>
    <h2 id="cta-title" class="h2" set:html={accent(titlu)} />
    <p class="lead">{text}</p>
    <a class="btn" href={rezervaHref} {...ext}>Programează-te <Icon name="arrow" size={18} /></a>
  </div>
</section>
<style>
  .cta { padding-block: calc(var(--section) * 0.4) var(--section); }
  .cta__card { max-width: 46rem; margin-inline: auto; padding: clamp(2.5rem, 6vw, 4.5rem) clamp(1.5rem, 5vw, 4rem); display: flex; flex-direction: column; align-items: center; text-align: center; gap: 1.5rem; background: var(--surface); }
</style>
