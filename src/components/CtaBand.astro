---
// Banda finală: tot câmpul este un singur link, iar cuvântul este butonul.
import Icon from './Icon.astro';
interface Props { word?: string; text?: string; href?: string }
const { word = 'Rezervă', text = 'Alege serviciul, ziua și ora. Îți confirmăm programarea cât mai repede.', href = '/rezerva' } = Astro.props;
---
<section class="cta" aria-labelledby="cta-title">
  <a class="cta__link" href={href}>
    <span class="cta__top wrap">
      <span class="cta__text" data-reveal>{text}</span>
      <span class="cta__arrow" data-reveal style="--i: 1"><Icon name="arrow-up-right" size={48} /></span>
    </span>
    <span class="cta__word" id="cta-title" data-reveal style="--i: 2">{word}</span>
  </a>
</section>
<style>
  .cta { background: var(--caramel); color: var(--espresso); }
  .cta__link { display: flex; flex-direction: column; justify-content: space-between; min-height: 60svh; text-decoration: none; color: inherit; transition: background-color 120ms linear, color 120ms linear; padding-block: 2rem 1.5rem; }
  .cta__top { display: flex; justify-content: space-between; gap: 2rem; align-items: flex-start; }
  .cta__text { font-size: var(--step-lead); line-height: 1.3; max-width: 28ch; }
  .cta__word { display: block; font-family: var(--font-display); font-size: clamp(5.5rem, 24vw, 26rem); line-height: 0.8; letter-spacing: -0.055em; padding-inline: calc(var(--margin) - 0.04em); white-space: nowrap; }
  .cta__link:hover, .cta__link:focus-visible { background: var(--espresso); color: var(--auriu); }
  .cta__link:focus-visible { outline-offset: -6px; outline-color: var(--auriu); }
  .cta__arrow { transition: transform 300ms var(--ease-out); }
  .cta__link:hover .cta__arrow { transform: translate(6px, -6px); }
  @media (max-width: 40rem) {
    .cta__link { min-height: 46svh; }
    .cta__text { font-size: 1.0625rem; }
    .cta__arrow :global(svg) { width: 32px; height: 32px; }
    .cta__word { font-size: 25vw; }
  }
</style>
