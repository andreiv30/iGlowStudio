# iGlow Studio — setări Apache/LiteSpeed pentru găzduirea statică din public_html

DirectoryIndex index.html index.php
AddType video/webm .webm
# diacriticele din fișierele text (llms.txt, robots.txt) se afișează corect
AddDefaultCharset UTF-8
AddCharset UTF-8 .txt .xml
ErrorDocument 404 /404.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Adresa unică: https://iglowstudio.ro (fără www, doar HTTPS)
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://iglowstudio.ro%{REQUEST_URI} [L,R=301]

  # Fișierele ascunse (.git, .env, .config.php...) nu se servesc; excepție .well-known (certificate SSL)
  RewriteRule (^|/)\.(?!well-known/) - [F,L]

  # Programările se fac pe Mero; paginile vechi de servicii au fost unite în categorii
  RewriteRule ^rezerva/?$ https://mero.ro/p/iglow-studio [R=301,L]
  RewriteRule ^servicii/(vopsit|balayage)/?$ /servicii/colorare/ [R=301,L]
  RewriteRule ^servicii/coafat/?$ /servicii/tratamente/ [R=301,L]

  # În folderul de poze nu rulează niciodată scripturi
  RewriteRule ^uploads/.*\.(php\d?|phtml|phar|pl|py|cgi|sh|asp|aspx|jsp|htaccess)$ - [F,NC,L]
</IfModule>

# Fișierele interne ale login-ului nu se accesează direct
<FilesMatch "^(\.config|_config|_page)\.php$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  # Securitate
  Header always set Strict-Transport-Security "max-age=15552000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
  Header always set Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
  Header always unset X-Powered-By

  # Panoul și login-ul nu apar în Google
  <FilesMatch "^(auth|parola)\.php$">
    Header set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>

  # Cache lung pentru fișierele care nu se schimbă (CSS și JS cu hash, fonturi), scurt pentru pagini
  <FilesMatch "\.(css|js|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|avif|jpe?g|png|svg|ico|webm)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.txt$">
    Header set Content-Type "text/plain; charset=utf-8"
  </FilesMatch>
</IfModule>

# Compresie
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>
