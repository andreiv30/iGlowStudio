# iGlow Studio — setări Apache pentru găzduirea statică din public_html

DirectoryIndex index.html index.php
ErrorDocument 404 /404.html
Options -Indexes

# Adresa principală: https://iglowstudio.ro (fără www).
# Decomentează după ce certificatul SSL e activ pe domeniu.
# RewriteEngine On
# RewriteCond %{HTTPS} !=on [OR]
# RewriteCond %{HTTP_HOST} ^www\. [NC]
# RewriteRule ^ https://iglowstudio.ro%{REQUEST_URI} [L,R=301]

# Fișierul cu secretele OAuth nu se servește niciodată
<FilesMatch "^(\.config|_config)\.php$">
  Require all denied
</FilesMatch>

# Cache lung pentru fișierele cu hash din numele lor (CSS, fonturi)
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2?|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
